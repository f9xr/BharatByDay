layout: null
sitemap: false
---
[{% for post in site.posts %}{"title": {{ post.title | jsonify }},"url": "{{ post.url | relative_url }}","date": "{{ post.date | date: "%B %-d, %Y" }}","tags": {{ post.tags | jsonify }},"excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},"content": {{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
